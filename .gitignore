# Local source exports and generated POC outputs
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/product_catalogue_skus.csv
!data/processed/sku_evidence_manifest.csv
!data/processed/datasheet_audit.csv
!data/processed/tds_links_to_source.csv
!data/processed/retrieval_cards.jsonl
!data/processed/retrieval_cleaning_report.csv
reports/*
!reports/.gitkeep
data/local/

# construction ingestion engine artefacts (regenerate with
# `python -m construction_ingest.main --build`)
data/construction_postcodes.db
data/postcode_zones.json
data/product_knowledge.json
data/tds/*
!data/tds/.gitkeep

# Derived from knowledge/building_classes/building_class_source.json; regenerate
# with `python -m construction_ingest.building_class --export-json --export-training`.
# building_class_rag_chunks.jsonl is deliberately NOT ignored: rag_answerer.py
# loads it at runtime.
knowledge/building_classes/building_class_profiles.json
knowledge/industry/training/building_class_finetune.jsonl

evidence/inbox/*
!evidence/inbox/.gitkeep
evidence/raw/*
!evidence/raw/.gitkeep

# Jupyter and Python
.ipynb_checkpoints/
__pycache__/
*.py[cod]

# pytest temp dirs (never commit test scratch trees)
.pytest-tmp/
.pytest_tmp/
.pytest_cache/
